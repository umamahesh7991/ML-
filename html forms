<!DOCTYPE html>
<html>
    <head>
        <title>Login form</title>
    </head>
    <body>
        <form>
            <fieldset>
                <legend>Welcome</legend>
            <h2>Pizza Login Form</h2>
            <label>First Name : </label><input placeholder="First Name" type="text" maxlength="20"><br><br>
            <label>Last Name : </label><input placeholder="Last Name" type="text" ><br><br>
            <label>Email Address : </label><input placeholder="Email id" type="email"><br><br>
            <label>Contact Number : </label><input placeholder="Contact Number" type="tel"><br><br>
            <label>Preferred Delivery Date : </label><input placeholder="Delivery Date" type="date"><br><br>
            <label>City: </label><input placeholder="City" value="Visakhapatnam" disabled><br><br>
            <label>Branch: </label><input placeholder="Branch" Value="Gajuwaka" readonly><br><br>
            <label>State : </label><select >
                <optgroup label="South States">
                <option>Andhra Pradesh</option>
                 <option>Telamgana</option>
                 <option>Tamilnadu</option>
                  <option>Kerala</option>
                   </optgroup>
                    <optgroup label="North States">
                <option>Sikkim</option>
                 <option>Madhya Pradesh</option>
                 <option>Uttar Pradesh</option>
                  <option>Delhi</option>
                   </optgroup>
            </select><br><br>
            <label>Size : </label><br>
            <input type="radio" name="size">small<input type="radio" name="size">Medium<input type="radio" name="size">Large<br><br>
            <label>Flavour : </label><br>
            <input type="checkbox"><label>Hawaiian (php 150.00)  </label><input type="number" min="1"><br>
            <input type="checkbox"><label>pepperion (php 140.00)  </label><input type="number" min="1"><br>
            <input type="checkbox"><label>vegetable (php 130.00)  </label><input type="number" min="1"><br><br>
            <label>Credit Card Number : </label><input type="number"><br><br>
            <label>Pin : </label><input type="number"><br><br>
            <label>Additional Note : </label><br><br>
            <textarea placeholder="enter more details" rows="5"></textarea><br><br>
            <input placeholder="submit" type="button" value="Submit Order">
            </fieldset>
        </form>
        
    </body>
</html>
