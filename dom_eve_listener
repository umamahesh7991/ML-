<!DOCTYPE html>
<html lang="en">
 <head>
    <script>
        function inputdom(){
var inp_dom=document.getElementById("input_box");
 inp_dom.placeholder="enter your name";
       }
        function btndom(){
var btndom=document.getElementById("btn");
btndom.innerText="Modified";
       }
       function btndom1(){
        var btndom1=document.getElementById("btn");
        btndom1.innerText="back";
       }
        function h2dom(){
var h2dom=document.getElementById("text");
 h2dom.style.color="blue";
       }
    </script>
 </head>
  <body>
 <h2 id="text" onmouseenter="h2dom()" >Query Selector</h2>
 <input id="input_box" type="text" placeholder="enter your text" onmouseenter="inputdom()" >
 <button id="btn" onmouseleave="btndom()" onmouseenter="btndom1()">Submit</button>
  </body>
</html>
